# Copy these into your host's environment variables (Railway / Fly / VPS).
# The website's Setup page shows the exact values for APP_URL and WORKER_TOKEN.
APP_URL=https://project--c67f1abf-f9f6-443f-b8db-3b7efbba99c6.lovable.app
WORKER_TOKEN=
# 64 hex characters. Generate with: openssl rand -hex 32
ENCRYPTION_KEY=
PORT=8080

# Required only because this worker currently reads linked Telegram sessions
# directly from Supabase for per-user session actions.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Local-only Telegram AI development.
# Use a separate test bot token from @BotFather. Do not use the production bot token.
LOCAL_DEV_MODE=false
DEV_TELEGRAM_BOT_TOKEN=
MINI_APP_URL=http://localhost:8080/mini-app

# Local/self-hosted OpenAI-compatible AI endpoint.
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=qwen2.5-coder:3b
# Optional. Ollama does not need this.
AI_API_KEY=
